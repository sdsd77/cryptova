# ===== مثال إعدادات النشر على Render.com (انسخ إلى إعدادات Render Environment Variables) =====
# لا ترفع هذا الملف نفسه — ضع القيم في لوحة تحكم Render مباشرة.

# --- منفذ السيرفر (Render يستخدم متغير PORT تلقائياً، نجعله 3000 افتراضياً) ---
PORT=3000

# --- الربط على كل الواجهات (مطلوب للاستضافة) ---
HOST=0.0.0.0

# --- خلف Render (Reverse Proxy مع SSL) — ثق بترددات الرأس لرؤية IP الزائر الحقيقي ---
TRUST_PROXY=1

# --- HTTPS مفعّل لأن Render يوفّر SSL تلقائياً ---
HTTPS=1

# --- لوحة التحكم - بيانات المدير (إلزامي! ضعها في Render Environment Variables) ---
ADMIN_USER=admin
ADMIN_PASSWORD=ضع_كلمة_مرور_قوية_طويلة_هنا
ADMIN_PATH=/control-ضع_مسار_سري_عشوائي_هنا

# --- مدة صلاحية جلسة لوحة التحكم بالساعات ---
ADMIN_SESSION_HOURS=12

# --- حماية تسجيل الدخول ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_DELAY_MS=500

# --- إرسال البريد (اختياري — نموذج التواصل يعمل أيضاً بدونه عبر Mailto + حفظ محلي) ---
# إن أردت إرسال نسخة تلقائية، استخدم App Password من Gmail:
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_TO=you@gmail.com

# --- المدونة ---
# على الخطة المجانية الخادم "ينام" بعد 15 دقيقة خمول، لذا نُعطّل الجدولة الدورية
# ونتكل على fetchIfStale (يجلُب الأخبار تلقائياً عند زيارة صفحة المدونة إذا مرّ >30 دقيقة)
BLOG_SCHEDULER=0
# عدد المقالات لكل جولة جلب
BLOG_POSTS_PER_RUN=5
# الحد الأدنى (بالدقائق) بين الجلب عند الزيارة
BLOG_REFRESH_MIN_MINUTES=30